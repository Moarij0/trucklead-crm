# ============================================================
#  TruckLead CRM — Docker deployment configuration
#  Copy to ".env" (same folder as docker-compose.yml) and edit.
# ============================================================

# --- Database (PostgreSQL) ---
POSTGRES_USER=truckcrm
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=truckcrm

# --- Security ---
# Generate one with:  openssl rand -hex 32
SECRET_KEY=CHANGE_ME_run_openssl_rand_hex_32

# --- First admin account (created automatically on first boot) ---
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@yourclient.com
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# --- Public address / HTTPS ---
# Local or IP only (HTTP):        :80
# Real domain (automatic HTTPS):  crm.yourclient.com
SITE_ADDRESS=:80

# --- Misc ---
# Allowed CORS origins ("*" is fine — the app uses bearer tokens, not cookies).
CORS_ORIGINS=*
# Seed demo leads on first boot (keep false for real client data).
SEED_ON_STARTUP=false
# Uvicorn worker processes.
WEB_CONCURRENCY=2
